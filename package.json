{
    "name": "devlab-developer-platform",
    "version": "1.0.0",
    "description": "Microservices-based developer analytics and learning platform",
    "private": true,
    "workspaces": [
        "api-gateway",
        "services/*",
        "client/*",
        "shared/*"
    ],
    "scripts": {
        "dev": "turbo run dev --ui=tui",
        "dev:stream": "turbo run dev --ui=stream",
        "dev:gateway": "turbo run dev --filter=api-gateway",
        "dev:developer": "turbo run dev --filter=developer-service",
        "dev:skill": "turbo run dev --filter=skill-service",
        "dev:analysis": "turbo run dev --filter=analysis-service",
        "dev:recommendation": "turbo run dev --filter=recommendation-service",
        "dev:notification": "turbo run dev --filter=notification-service",
        "dev:client": "turbo run dev --filter=nextjs",
        "build": "turbo run build",
        "test": "turbo run test",
        "test:cov": "turbo run test:cov",
        "test:python": "python -m pytest -c services/nlp-service/pytest.ini services/nlp-service/tests",
        "test:python:cov": "python -m pytest -c services/nlp-service/pytest.ini services/nlp-service/tests --cov --cov-config=services/nlp-service/.coveragerc --cov-report=xml:services/nlp-service/coverage.xml --cov-report=term-missing",
        "lint": "turbo run lint",
        "lint:fix": "turbo run lint:fix",
        "typecheck": "turbo run typecheck",
        "clean": "turbo run clean",
        "ci": "turbo run lint typecheck build test",
        "sonar:up": "docker compose --profile sonar up -d sonarqube",
        "sonar:down": "docker compose --profile sonar down",
        "sonar:scan": "docker compose --profile sonar run --rm sonar-scanner",
        "docker:up": "docker-compose up -d",
        "docker:down": "docker-compose down",
        "docker:logs": "docker-compose logs -f",
        "docker:postgres": "docker logs -f devlab-postgres",
        "docker:mongodb": "docker logs -f devlab-mongodb",
        "docker:redis": "docker logs -f devlab-redis",
        "docker:kafka": "docker logs -f devlab-kafka"
    },
    "devDependencies": {
        "@types/jest": "^29.5.11",
        "@types/react": "18.2.22",
        "@types/react-dom": "18.2.7",
        "concurrently": "^8.2.2",
        "jest": "^29.7.0",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "ts-jest": "^29.1.1",
        "turbo": "^2.8.9",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    },
    "packageManager": "npm@10.2.4"
}
