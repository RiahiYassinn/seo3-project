{
    "name": "seo3-developer-platform",
    "version": "1.0.0",
    "description": "Microservices-based developer analytics and learning platform",
    "private": true,
    "workspaces": [
        "api-gateway",
        "services/*",
        "client/*",
        "shared/*"
    ],
    "scripts": {
        "dev": "turbo run dev --ui=tui",
        "dev:stream": "turbo run dev --ui=stream",
        "dev:gateway": "turbo run dev --filter=api-gateway",
        "dev:developer": "turbo run dev --filter=developer-service",
        "dev:skill": "turbo run dev --filter=skill-service",
        "dev:analysis": "turbo run dev --filter=analysis-service",
        "dev:recommendation": "turbo run dev --filter=recommendation-service",
        "dev:notification": "turbo run dev --filter=notification-service",
        "dev:client": "turbo run dev --filter=web",
        "build": "turbo run build",
        "test": "turbo run test",
        "lint": "turbo run lint",
        "clean": "turbo run clean",
        "docker:up": "docker-compose up -d",
        "docker:down": "docker-compose down",
        "docker:logs": "docker-compose logs -f",
        "docker:app:up": "node -e \"require('child_process').execSync(process.platform==='win32'?'powershell -ExecutionPolicy Bypass -File scripts/docker-up.ps1':'bash scripts/docker-up.sh',{stdio:'inherit'})\"",
        "docker:app:down": "docker compose -f docker-compose.prod.yml down",
        "docker:app:build": "docker compose -f docker-compose.prod.yml build",
        "docker:app:logs": "docker compose -f docker-compose.prod.yml logs -f",
        "docker:postgres": "docker logs -f seo3-postgres",
        "docker:mongodb": "docker logs -f seo3-mongodb",
        "docker:redis": "docker logs -f seo3-redis",
        "docker:kafka": "docker logs -f seo3-kafka"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "concurrently": "^8.2.2",
        "turbo": "^2.8.9",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    },
    "packageManager": "npm@10.2.4",
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "clsx": "^2.1.1",
        "framer-motion": "^12.34.5",
        "tailwind-merge": "^3.5.0"
    }
}
