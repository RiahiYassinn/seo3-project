# Copy to .env.docker before running docker-compose.prod.yml
# cp .env.docker.example .env.docker

NODE_ENV=production

# Auth (required)
JWT_ACCESS_SECRET=change-me-access-secret-for-docker
JWT_REFRESH_SECRET=change-me-refresh-secret-for-docker
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRES_IN=30d

# GitHub token encryption (64-char hex = 32 bytes, required by developer-service)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional external integrations
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GEMINI_API_KEY=
GROQ_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Recommendation / LLM
AUTO_GENERATE_RECOMMENDATIONS=false
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@seo3-platform.com

# Logging
LOG_LEVEL=info
