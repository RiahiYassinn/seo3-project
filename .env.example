# Application
NODE_ENV=development
APP_PORT=3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=seo3_user
POSTGRES_PASSWORD=seo3_password
POSTGRES_DB=seo3_db
DATABASE_URL=postgresql://seo3_user:seo3_password@localhost:5432/seo3_db

# MongoDB
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=seo3_user
MONGODB_PASSWORD=seo3_password
MONGODB_DATABASE=seo3_analytics
MONGODB_URL=mongodb://seo3_user:seo3_password@localhost:27017/seo3_analytics?authSource=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=seo3-platform
KAFKA_GROUP_ID=seo3-group

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this
JWT_REFRESH_EXPIRES_IN=30d

# API Gateway
API_GATEWAY_PORT=3000
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Microservices Ports
DEVELOPER_SERVICE_PORT=3001
DEVELOPER_SERVICE_HTTP_PORT=3011
SKILL_SERVICE_PORT=3002
ANALYSIS_SERVICE_PORT=3003
RECOMMENDATION_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005
NLP_SERVICE_PORT=8000

# External APIs
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GROQ_API_KEY=your-groq-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_WEBHOOK_SECRET=

BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# Google OAuth
# Get credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3006/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@seo3-platform.com

# Slack Integration
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=

# Learning Platforms
UDEMY_CLIENT_ID=
UDEMY_CLIENT_SECRET=

COURSERA_CLIENT_ID=
COURSERA_CLIENT_SECRET=

# NLP Service
NLP_MODEL_PATH=./models
SPACY_MODEL=en_core_web_sm

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# CORS
CORS_ORIGIN=http://localhost:3000


