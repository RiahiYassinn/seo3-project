# Application
NODE_ENV=development
APP_PORT=3000

# Container images (docker-compose.prod.yml)
# Leave as-is to build locally; set IMAGE_TAG to a tag published by CI
# (e.g. sha-1a2b3c4 or a release like 1.4.0) to run prebuilt images instead.
REGISTRY=ghcr.io/riahiyassinn/devlab-project
IMAGE_TAG=latest
WEB_CLIENT_PORT=3010

# Base URL the browser uses to reach the gateway. The web client reads both
# spellings (lib/api.ts vs lib/auth.ts), so keep them equal. Under docker these
# are passed as a BUILD arg, since Next inlines NEXT_PUBLIC_* at build time.
NEXT_PUBLIC_API_GATEWAY=http://localhost:3000
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3000

# PostgreSQL
# HOST/URL values here are for running services directly on the host; in docker
# the compose file overrides the hosts with the compose service names.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=devlab_user
POSTGRES_PASSWORD=devlab_password
POSTGRES_DB=devlab_db
DATABASE_URL=postgresql://devlab_user:devlab_password@localhost:5432/devlab_db

# Set to true for the first boot against an empty database so TypeORM creates
# the tables from the entities. Leave false afterwards.
DB_SYNC=false

# MongoDB
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=devlab_user
MONGODB_PASSWORD=devlab_password
MONGODB_DATABASE=devlab_analytics
MONGODB_URL=mongodb://devlab_user:devlab_password@localhost:27017/devlab_analytics?authSource=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=devlab-platform
KAFKA_GROUP_ID=devlab-group

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this
JWT_REFRESH_EXPIRES_IN=30d

# API Gateway
API_GATEWAY_PORT=3000
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Microservices Ports
DEVELOPER_SERVICE_PORT=3001
DEVELOPER_SERVICE_HTTP_PORT=3011
SKILL_SERVICE_PORT=3002
ANALYSIS_SERVICE_PORT=3003
RECOMMENDATION_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005
NLP_SERVICE_PORT=8000

# Encrypts stored GitHub OAuth tokens (developer-service refuses to boot
# without it). 32 bytes hex: openssl rand -hex 32
# Changing it makes already-stored tokens undecryptable.
TOKEN_ENCRYPTION_KEY=

# External APIs
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=
GROQ_API_KEY=your-groq-api-key
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
ANALYSIS_SNAPSHOT_CHUNK_BYTES=240000

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_WEBHOOK_SECRET=

BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# Google OAuth
# Get credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3006/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@devlab-platform.com

# Slack Integration
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=

# Learning Platforms
UDEMY_CLIENT_ID=
UDEMY_CLIENT_SECRET=

COURSERA_CLIENT_ID=
COURSERA_CLIENT_SECRET=

# NLP Service
NLP_MODEL_PATH=./models
SPACY_MODEL=en_core_web_sm

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# CORS
CORS_ORIGIN=http://localhost:3000


